# Docker Compose template configuration. Copy to .env and replace every value.
POSTGRES_DB=mmcat
POSTGRES_USER=mmcat
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password
S3_ACCESS_KEY_ID=mmcat
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-minio-password

APP_ENV=production
SESSION_COOKIE_NAME=__Host-mmcat-session
APP_BASE_URL=https://example.com
API_BASE_URL=https://api.example.com
TRUSTED_HOSTS=example.com,api.example.com
CORS_ORIGINS=https://example.com
SESSION_SECRET=replace-with-a-different-32-byte-minimum-secret
HASH_IP_SECRET=replace-with-a-different-32-byte-minimum-secret
S3_BUCKET=mmcat
S3_PUBLIC_BASE_URL=https://cdn.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=no-reply@example.com
