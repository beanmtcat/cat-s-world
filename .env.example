# Docker Compose template configuration. Copy to .env and replace every value.
POSTGRES_DB=mmcat
POSTGRES_USER=mmcat
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password
# MinIO administrator; used only to bootstrap the bucket and the API account.
MINIO_ROOT_USER=mmcat-root
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-root-password
# Bucket-scoped account used by the API.
S3_ACCESS_KEY_ID=mmcat-api
S3_SECRET_ACCESS_KEY=replace-with-a-different-long-random-s3-password

APP_ENV=production
SESSION_COOKIE_NAME=__Host-mmcat-session
APP_BASE_URL=https://example.com
TRUSTED_HOSTS=example.com,api.example.com
CORS_ORIGINS=https://example.com
# Recommended: serve the API under the same origin as the site (proxy /api to it)
# and leave this empty.  If the API runs on another host of the same site, e.g.
# api.example.com, set the shared parent domain so the SPA can read the CSRF cookie.
CSRF_COOKIE_DOMAIN=
# IP or CIDR of the reverse proxy in front of the API (comma separated).
FORWARDED_ALLOW_IPS=172.16.0.0/12
WEB_CONCURRENCY=2
SESSION_SECRET=replace-with-a-different-32-byte-minimum-secret
HASH_IP_SECRET=replace-with-a-different-32-byte-minimum-secret
S3_BUCKET=mmcat
S3_PUBLIC_BASE_URL=https://cdn.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=no-reply@example.com
