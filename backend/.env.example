APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://mmcat:mmcat@postgres:5432/mmcat
# Match REDIS_PASSWORD from the repository-root .env file.
REDIS_URL=redis://:replace-with-your-redis-password@redis:6379/0
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=mmcat-session
CSRF_COOKIE_NAME=mmcat-csrf
SESSION_SECRET=replace-with-a-minimum-32-byte-random-secret
HASH_IP_SECRET=replace-with-a-different-minimum-32-byte-random-secret
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mmcat
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_QUARANTINE_PREFIX=quarantine
S3_PUBLIC_PREFIX=public
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
MAIL_FROM=no-reply@example.com
SEARCH_ENGINE_SECRET_PROVIDER=environment
SEARCH_ENGINE_SECRET_NAMESPACE=mmcat/search-engines
